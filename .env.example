# Copy to .env and fill in your keys. Do not commit real .env.

# --- Optional: Tradier sandbox (options chains / real API instead of mock) ---
# Get a sandbox token from Tradier; used as Bearer against https://sandbox.tradier.com/v1
# TRADIER_SANDBOX_TOKEN=
# TRADIER_ACCOUNT_ID=
# (alias) TRADIER_SANDBOX_ACCOUNT=

# --- Optional: ML ranking at paper rebalance (requires models/rf_regressor.joblib; RNN optional) ---
# ML_RANK_WEIGHT=0.3

# Rank by predicted forward excess vs SPY (requires models/rf_alpha_regressor.joblib; train via ml/train_rf_alpha.py)
# When set, ML_RANK_WEIGHT blend is skipped; rules composite kept as rulesCompositeScore.
# ML_ALPHA_RANKING=1

# Hybrid composite on GET /api/analysis/:ticker (RF structural + rules valuation/momentum)
# ML_COMPOSITE_ANALYSIS=1

# RF "winning cluster" blend into single-ticker composite (requires models/rf_cluster_classifier.joblib; python ml/train_rf_cluster.py)
# When set, takes priority over ML_COMPOSITE_ANALYSIS structural path if cluster predict succeeds.
# ML_COMPOSITE_CLUSTER=1
# ML_CLUSTER_BLEND=0.45

# Rolling IC window length in rebalance periods (default 12). Optional ridge on stacked panels:
# ADAPTIVE_RIDGE=1
# ADAPTIVE_RIDGE_LAMBDA=1
# ROLLING_IC_PERIODS=12

# Trailing giveback stop: default OFF (unset/empty). Set to 1 only if you want it; hard stops use entry price + vol bands.
# TRAILING_STOP_ENABLED=1

# Append adaptiveWeightLog to GET /api/backtest/* JSON (for scripts/oos_adaptive_replay.mjs)
# ADAPTIVE_WEIGHT_LOG=1

# Verbose [ADAPTIVE] clamp / floor-renorm diagnostics (compose + optional server line after conservative blend)
# ADAPTIVE_CLAMP_DEBUG=1

# When TRAILING_STOP_ENABLED=1, tuning uses TRAILING_STOP_* in server.js (min peak gain, entry floor, min hold days).

# [TURNOVER] / [HOLD] logs for rebalance sell and rebuy cooldown (server backtest + paper)
# TURNOVER_DEBUG=1

# Log Spearman correlation DCF score vs ~42 trading-day forward return each rank (bt_rankFullCompositeV2; noisy)
# DCF_IC_DIAGNOSTIC=1

# One log line: pillar weights used on first rebalance (backtest / paper rank path debugging)
# RANK_WEIGHT_DEBUG=1

# Use one-shot subprocess per predict instead of persistent ml/predict_worker.py (debug only)
# ML_PREDICT_WORKER=0

# Optional: override Python (otherwise server uses .venv/bin/python3 if present)
# PYTHON=/absolute/path/to/python3
