# Copy this file to `.env` (NEVER commit `.env`).
# Every variable is optional — the app boots with mock data if all secrets are
# absent. Add only what you need.

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Persistent data directory. Leave unset locally (uses repo root); on Railway
# (or any host with a mounted volume) set this so paper portfolios and trained
# RL agents survive deploys.
# DATA_DIR=/data

# CORS allow-list when the UI is hosted on a different origin than the API
# (Vercel + Railway split deploy).
# FRONTEND_URL=https://your-frontend.vercel.app

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# Where the dev server proxies /api in `npm run dev:all`.
# VITE_API_TARGET=http://localhost:3001
# Absolute API base burned into the production build (split hosting only).
# VITE_API_BASE=https://your-api.up.railway.app

# ─── Optional: data providers ──────────────────────────────────────────────
# FRED — U.S. macro series for backtest inflation. Free key:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Finnhub — congressional trade disclosures (STOCK Act). Free key, instant:
#   https://finnhub.io  (no credit card required)
# Used by GET /api/congress/signal and the weekly Sunday 6 AM cron.
# App degrades gracefully when absent (congressScore = 0 for all tickers).
# FINNHUB_API_KEY=

# Tradier sandbox — real options chains (otherwise mock chains are used).
# https://documentation.tradier.com/sandbox
# TRADIER_SANDBOX_TOKEN=
# TRADIER_ACCOUNT_ID=

# Alpha Vantage — quote fallback (rarely used). https://www.alphavantage.co
# VITE_AV_KEY=

# Anthropic — only if you wire LLM helpers into the UI (not required).
# VITE_ANTHROPIC_API_KEY=

# ─── Optional: ML blending (requires Python + models/) ─────────────────────
# ML_RANK_WEIGHT=0.25            # 0–1 blend of RF rank into rules composite
# ML_ALPHA_RANKING=1             # rank by predicted forward excess vs SPY
# ML_COMPOSITE_ANALYSIS=1        # hybrid composite on /api/analysis/:ticker
# ML_COMPOSITE_CLUSTER=1         # blend RF "winning cluster" prob
# ML_CLUSTER_BLEND=0.45
# ML_PREDICT_WORKER=0            # disable persistent worker (debug only)
# PYTHON=/absolute/path/to/python3   # override .venv/bin/python3

# ─── Optional: RL overlay ──────────────────────────────────────────────────
# RL_ENABLED=true                # use trained agent when available
# RL_AGENT_TYPE=qlearning        # or `dqn`

# ─── Optional: adaptive composite tuning ───────────────────────────────────
# ROLLING_IC_PERIODS=12
# ADAPTIVE_RIDGE=1
# ADAPTIVE_RIDGE_LAMBDA=1
# TRAILING_STOP_ENABLED=1

# ─── Optional: diagnostic logs ─────────────────────────────────────────────
# ADAPTIVE_WEIGHT_LOG=1
# ADAPTIVE_CLAMP_DEBUG=1
# TURNOVER_DEBUG=1
# DCF_IC_DIAGNOSTIC=1
# RANK_WEIGHT_DEBUG=1
