{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/market/indices", "destination": "/api/dashboard/summary?kind=indices" },
    { "source": "/api/health", "destination": "/api/scores?health=1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

